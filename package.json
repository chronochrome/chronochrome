{
  "name": "chronochrome-monorepo",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "build": "pnpm -r --filter './packages/*' run build",
    "test": "pnpm -r --filter './packages/*' run test",
    "typecheck": "pnpm -r run typecheck",
    "lint": "pnpm -r run lint",
    "publint": "pnpm -r --filter './packages/*' run publint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "quality": "pnpm build && pnpm typecheck && pnpm lint && pnpm format:check && pnpm test && pnpm publint",
    "dev": "pnpm --filter @chronochrome/demo dev",
    "build:demo": "pnpm --filter @chronochrome/demo build",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "pnpm build && changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.1",
    "@eslint/js": "^10.0.1",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "prettier": "^3.9.9",
    "publint": "^0.3.25",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^3.2.7"
  },
  "engines": {
    "node": ">=18"
  }
}
