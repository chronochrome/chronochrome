{
  "name": "@chronochrome/tailwind",
  "version": "0.1.0",
  "description": "ChronoChrome adapter for Tailwind CSS — living accent as bg-accent / text-accent",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./theme.css": "./src/theme.css",
    "./plugin": {
      "import": {
        "types": "./dist/plugin.d.ts",
        "default": "./dist/plugin.js"
      },
      "require": {
        "types": "./dist/plugin.d.cts",
        "default": "./dist/plugin.cjs"
      }
    }
  },
  "files": [
    "dist",
    "src/theme.css",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup src/index.ts src/plugin.ts --format esm,cjs --dts --clean",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "publint": "publint"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chronochrome/chronochrome.git",
    "directory": "packages/tailwind"
  },
  "bugs": {
    "url": "https://github.com/chronochrome/chronochrome/issues"
  },
  "homepage": "https://github.com/chronochrome/chronochrome/tree/main/packages/tailwind#readme",
  "keywords": [
    "chronochrome",
    "tailwind",
    "tailwindcss",
    "circadian",
    "accent",
    "css-variables"
  ],
  "author": "isamarin × BLMK",
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "peerDependencies": {
    "chronochrome": "^1.0.0",
    "tailwindcss": ">=3.4.0"
  },
  "peerDependenciesMeta": {
    "tailwindcss": {
      "optional": true
    }
  },
  "devDependencies": {
    "chronochrome": "workspace:^"
  },
  "sideEffects": [
    "*.css"
  ],
  "engines": {
    "node": ">=18"
  }
}
