{
  "name": "@chronohue/svelte",
  "version": "0.1.0",
  "description": "ChronoHue adapter for Svelte 5 — living accent as a store and <ChronoHue>",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "svelte": "./src/ChronoHue.svelte",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./ChronoHue.svelte": {
      "types": "./src/ChronoHue.svelte.d.ts",
      "svelte": "./src/ChronoHue.svelte",
      "default": "./src/ChronoHue.svelte"
    }
  },
  "files": [
    "dist",
    "src/ChronoHue.svelte",
    "src/ChronoHue.svelte.d.ts",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "publint": "npm run build && publint",
    "quality": "npm run typecheck && npm run lint && npm run format:check && npm run test && npm run publint",
    "prepublishOnly": "npm run quality"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/isamarin/chronohue-svelte.git"
  },
  "bugs": {
    "url": "https://github.com/isamarin/chronohue-svelte/issues"
  },
  "homepage": "https://github.com/isamarin/chronohue-svelte#readme",
  "keywords": [
    "chronohue",
    "svelte",
    "svelte5",
    "circadian",
    "accent",
    "css-variables",
    "igrs"
  ],
  "author": "isamarin × BLMK",
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "peerDependencies": {
    "chronohue": "^1.0.0",
    "svelte": "^5.0.0"
  },
  "peerDependenciesMeta": {
    "svelte": {
      "optional": true
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "chronohue": "^1.0.0",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.9.0",
    "prettier": "^3.9.6",
    "publint": "^0.3.23",
    "svelte": "^5.38.0",
    "tsup": "^8.5.0",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.66.0",
    "vitest": "^3.2.4"
  },
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  }
}
