{
  "name": "@chronochrome/svelte",
  "version": "1.1.0",
  "description": "ChronoChrome adapter for Svelte 5 — living accent as a store and <ChronoChrome>",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "svelte": "./src/ChronoChrome.svelte",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./ChronoChrome.svelte": {
      "types": "./src/ChronoChrome.svelte.d.ts",
      "svelte": "./src/ChronoChrome.svelte",
      "default": "./src/ChronoChrome.svelte"
    }
  },
  "files": [
    "dist",
    "src/ChronoChrome.svelte",
    "src/ChronoChrome.svelte.d.ts",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "publint": "publint"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chronochrome/chronochrome.git",
    "directory": "packages/svelte"
  },
  "bugs": {
    "url": "https://github.com/chronochrome/chronochrome/issues"
  },
  "homepage": "https://github.com/chronochrome/chronochrome/tree/main/packages/svelte#readme",
  "keywords": [
    "chronochrome",
    "svelte",
    "svelte5",
    "circadian",
    "accent",
    "css-variables"
  ],
  "author": "isamarin × BLMK",
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "peerDependencies": {
    "chronochrome": "^2.0.1",
    "svelte": "^5.0.0"
  },
  "peerDependenciesMeta": {
    "svelte": {
      "optional": true
    }
  },
  "devDependencies": {
    "chronochrome": "workspace:^",
    "svelte": "^5.38.0"
  },
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  }
}
