{
  "name": "@chronochrome/widget",
  "version": "1.0.1",
  "description": "ChronoChrome sky widget — sun and moon on their day arcs",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./sky.css": "./src/sky.css"
  },
  "files": [
    "dist",
    "src/sky.css",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "publint": "publint"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chronochrome/chronochrome.git",
    "directory": "packages/widget"
  },
  "bugs": {
    "url": "https://github.com/chronochrome/chronochrome/issues"
  },
  "homepage": "https://github.com/chronochrome/chronochrome/tree/main/packages/widget#readme",
  "keywords": [
    "chronochrome",
    "sun",
    "moon",
    "sky",
    "widget",
    "svg"
  ],
  "author": "isamarin × BLMK",
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "peerDependencies": {
    "chronochrome": "^2.0.1"
  },
  "devDependencies": {
    "chronochrome": "workspace:^",
    "jsdom": "^26.1.0"
  },
  "sideEffects": [
    "*.css"
  ],
  "engines": {
    "node": ">=18"
  }
}
