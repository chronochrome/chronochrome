{
  "name": "@chronohue/widget",
  "version": "0.1.0",
  "description": "ChronoHue sky widget — sun and moon on their day arcs",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./sky.css": "./src/sky.css"
  },
  "files": [
    "dist",
    "src/sky.css",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "publint": "npm run build && publint",
    "quality": "npm run typecheck && npm run lint && npm run format:check && npm run test && npm run publint"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chronohue/widget.git"
  },
  "bugs": {
    "url": "https://github.com/chronohue/widget/issues"
  },
  "homepage": "https://github.com/chronohue/widget#readme",
  "keywords": [
    "chronohue",
    "sun",
    "moon",
    "sky",
    "widget",
    "svg"
  ],
  "author": "isamarin × BLMK",
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "peerDependencies": {
    "chronohue": "^1.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "chronohue": "^1.0.0",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.9.0",
    "jsdom": "^26.1.0",
    "prettier": "^3.9.6",
    "publint": "^0.3.23",
    "tsup": "^8.5.0",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.66.0",
    "vitest": "^3.2.4"
  },
  "sideEffects": [
    "*.css"
  ],
  "engines": {
    "node": ">=18"
  }
}
